CC = gcc
CFLAGS = -Wall -Wextra -std=gnu11 -g -I./cJSON -I./core -I/usr/include/dilithium
LDFLAGS = -lpqcrystals_dilithium5_ref -lpqcrystals_fips202_ref -lcurl -lb64 -lpthread -lz -lcrypto -lssl

SRCDIR = .
CJSONDIR = ./cJSON
COREDIR = ./core

SRC = $(SRCDIR)/alice.c \
      $(COREDIR)/connection_qkd.c \
      $(COREDIR)/handle_json.c \
      $(CJSONDIR)/cJSON.c \
      $(COREDIR)/cryptografy.c \
      $(COREDIR)/handle_msg.c \
      $(COREDIR)/sign_dilithium.c

OBJS = $(SRC:.c=.o)
TARGET = alice

.PHONY: all clean run

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)

run: $(TARGET)
	./$(TARGET)